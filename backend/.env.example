# ─── Backend Environment ─────────────────────────────────
# Server
HOST=0.0.0.0
PORT=8000
APP_DEBUG=true

# Database — change to PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/xongket
DATABASE_URL=sqlite:///./xongket.db

# MQTT Broker (optional)
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC=sensors/+/+

# Optional Master API Key
# MASTER_API_KEY=xongket-secret-master-key

# Cloud storage (future)
# CLOUD_BUCKET=xongket-data

# AI model paths (future)
# MODEL_DIR=./models
