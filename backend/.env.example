# ─── Backend Environment ─────────────────────────────────
# Server
HOST=0.0.0.0
PORT=8000
APP_DEBUG=true

# Database — SQLite by default, change to PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/xongket
DATABASE_URL=sqlite:///./xongket.db

# ─── Auth / JWT ──────────────────────────────────────────
JWT_SECRET=xongket-disaster-management-secret-key-assam-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── MQTT Broker (optional native Mosquitto integration) ──
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=sensors/+/+
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Optional Master API Key (can bypass individual node key checks if set)
# MASTER_API_KEY=xongket-secret-master-key

# ─── AI Forecasting Scheduler ────────────────────────────
FORECAST_SCHEDULER_ENABLED=true
FORECAST_INTERVAL_MINUTES=10

# ─── Multi-Channel Alert Delivery Providers ──────────────
# Choices: "mock" (default, logs to DB/console) or "twilio" / "meta"
ALERT_SMS_PROVIDER=mock
ALERT_VOICE_PROVIDER=mock
ALERT_WHATSAPP_PROVIDER=mock

# Twilio Credentials (when ALERT_SMS_PROVIDER=twilio or ALERT_VOICE_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1234567890

# Meta WhatsApp Cloud API (when ALERT_WHATSAPP_PROVIDER=meta)
# META_WA_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
# META_WA_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxx
